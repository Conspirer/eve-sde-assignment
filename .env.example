# Copy this file to .env and change the secrets.
# Leave DATABASE_URL out to use a local SQLite file (eve.db).
DATABASE_URL=postgresql+psycopg2://eve:eve@localhost:5432/eve
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
JWT_EXPIRE_MINUTES=60
WEBHOOK_SECRET=change-me-webhook-secret
# Optional: enables caching and shared rate limits
REDIS_URL=redis://localhost:6379/0
